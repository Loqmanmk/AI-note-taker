# Only needed when the app cannot find the server by itself (for example with `expo start --tunnel`).
# Use your computer's address on the Wi-Fi network, with the port the web app runs on.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Accounts (Google sign-in) and saved classes: the same two values as NEXT_PUBLIC_SUPABASE_* in the
# project root's .env.local. Without them the app runs without sign-in and keeps classes on the phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Error reports (Sentry): the project's DSN, from Sentry → Project settings → Client Keys (DSN).
# Not a secret. Reports are only sent from installed apps, never while developing.
# EXPO_PUBLIC_SENTRY_DSN=
