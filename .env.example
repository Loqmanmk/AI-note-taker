# Copy this file to .env.local and fill in ONE key. Never commit .env.local.

# Free option: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try, in order, separated by commas
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# Paid option: key from https://platform.claude.com (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=

# Accounts (Google sign-in) and saved classes, from your Supabase project: Project Settings > API.
# The publishable key is safe to expose; the database rules protect each student's data.
# Without these, sign-in is off in development and the server refuses requests in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown on the privacy policy and account deletion pages (public). Set them in Vercel for the live site.
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=

# Payments on the website with Paddle (see docs/payments.md). Leave empty to keep payments off.
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_PRICE_PREMIUM_MONTHLY=
# NEXT_PUBLIC_PADDLE_PRICE_PREMIUM_YEARLY=
# NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
# NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
# Server-only secrets: never prefix them with NEXT_PUBLIC_.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# SUPABASE_SECRET_KEY=

# Speech-to-text with Groq Whisper (optional, server-only secret). With it, recordings are transcribed
# first and Gemini writes the notes from the text, which costs much less. Arabic/Darija classes, files
# over GROQ_MAX_FILE_MB, and any Groq failure fall back to Gemini listening to the audio.
# GROQ_API_KEY=
# GROQ_MAX_FILE_MB=25

# Admin console (/admin): emails allowed in, comma separated. Server-only.
# ADMIN_EMAILS=you@example.com
