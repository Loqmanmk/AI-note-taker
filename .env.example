# Copy this file to .env.local and fill in ONE key. Never commit .env.local.

# Free option: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try, in order, separated by commas
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# Paid option: key from https://platform.claude.com (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=
