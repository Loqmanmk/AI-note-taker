# Copy this file to .env.local and fill in ONE key. Never commit .env.local.

# Free option: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try, in order, separated by commas
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# Paid option: key from https://platform.claude.com (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=

# Accounts (Google sign-in) and saved classes, from your Supabase project: Project Settings > API.
# The publishable key is safe to expose; the database rules protect each student's data.
# Without these, sign-in is off in development and the server refuses requests in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown on the privacy policy and account deletion pages (public). Set them in Vercel for the live site.
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=
